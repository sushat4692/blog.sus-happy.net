---
interface Props {
    title?: string;
    subTitle?: string;
    body?: HTMLElement;
    isPageTitle?: boolean;
}

const { title, subTitle, body, isPageTitle = true } = Astro.props;
---

<div class="wrap">
    <div class="l-container">
        <div class="inner">
            {title && isPageTitle && <h1 class="title">{title}</h1>}
            {title && !isPageTitle && <p class="title"><a href="/">{title}</a></p>}
            {subTitle && <p class="sub_title">{subTitle}</p>}
            {body}
        </div>
    </div>
</div>

<style lang="scss">
    @reference "tailwindcss";

    // .wrap {
    //     @apply pt-20;

    //     @screen sm {
    //         @apply pt-10;
    //     }
    // }

    .inner {
        @apply pb-8 border-0;

        @screen sm {
            @apply pb-9;
        }
    }

    .title {
        @apply text-2xl font-black tracking-wide m-0;

        @screen sm {
            @apply text-2xl;
        }
    }

    .sub_title {
        @apply text-sm font-normal mt-2;

        @screen sm {
            @apply text-base;
        }
    }
</style>
